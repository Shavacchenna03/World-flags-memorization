# World Flags — Supabase Configuration Example
# Copy this file to .env.local and fill in your Supabase project credentials.
#
# Obtain these values from your Supabase Dashboard:
# 1. Project Settings -> API
# 2. Project URL -> NEXT_PUBLIC_SUPABASE_URL
# 3. Project API Keys -> anon / public key -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (or NEXT_PUBLIC_SUPABASE_ANON_KEY)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Optional alias supported for standard Supabase conventions:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
